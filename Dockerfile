# Используем официальный легковесный образ LTS-версии n8n
FROM n8nio/n8n:latest

# Переключаемся на пользователя node (в официальном образе он имеет ID 1000)
USER root

# Создаем директорию для кастомных расширений
RUN mkdir -p /custom-nodes && \
    # Меняем владельца, чтобы пользователь node мог записывать данные при необходимости
    chown -R node:node /custom-nodes

# Возвращаемся к непривилегированному пользователю из соображений безопасности
USER node

# Устанавливаем рабочую директорию для установки npm-пакетов
WORKDIR /custom-nodes

# Копируем только package.json вашего узла, если вы собираете монорепозиторий или хотите закэшировать слои.
# Если репозиторий публичный и это чистый git+install, этот шаг можно пропустить. 
# Оставлен здесь как пример лучшей практики сборки в Docker.
COPY --chown=node:node ./package*.json ./

# Устанавливаем ваш узел напрямую из GitHub
# Флаг --unsafe-perm нужен внутри контейнера, так как npm пытается сменить владельца файлов
RUN npm install git+https://github.com/allexkoldun/n8n-experiment1.git --unsafe-perm --omit=dev

# Важный момент: возвращать WORKDIR в /data необязательно для работы entrypoint,
# но полезно оставить /custom-nodes, чтобы пути были предсказуемыми.
# Основная рабочая директория самого n8n останется /data (она задана в базовом образе).

# Объявляем переменную окружения прямо в сборке. 
# Amvera также может пробросить её через интерфейс Variables, но фиксация в Dockerfile надежнее.
ENV N8N_CUSTOM_EXTENSIONS=/custom-nodes

EXPOSE 5678

# CMD наследуется от родительского образа n8nio/n8n:latest ("n8n start")
